---
interface Props {
  title: string;
  text: string;
  img: string;
  href: string;
  id?: string;
  variant?: 'service' | 'condition';
  class?: string;
}
const { title, text, img, href, id, variant = 'service', class: className } = Astro.props;
const isCondition = variant === 'condition';
---

<li class:list={['flip', className]} data-axis={isCondition ? 'x' : undefined} id={id}>
  <div class="flip-inner outline-offset-4" tabindex="0" role="group" aria-label={title}>
    <!-- Front: photo + title -->
    <div class="flip-face bg-plum-900">
      <img src={img} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      {isCondition ? (
        <>
          <div class="absolute inset-0 bg-gradient-to-t from-plum-950/85 via-plum-950/20 to-plum-950/10"></div>
          <div class="absolute inset-3 rounded border border-pearl-50/40"></div>
          <h3 class="absolute inset-x-0 bottom-0 px-6 pb-8 text-center font-display text-[2rem] font-light leading-none text-pearl-50">{title}</h3>
        </>
      ) : (
        <>
          <div class="absolute inset-0 bg-gradient-to-t from-plum-950/90 via-plum-950/30 to-plum-950/10"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-7 text-pearl-50">
            <h3 class="font-display text-[2.1rem] font-light leading-none">{title}</h3>
            <svg viewBox="0 0 20 20" class="mb-1 h-5 w-5 shrink-0 fill-none stroke-pearl-50/70" stroke-width="1.3" aria-hidden="true"><path d="M3 10a7 7 0 0 1 12-5l2 2M17 3v4h-4M17 10a7 7 0 0 1-12 5l-2-2M3 17v-4h4" /></svg>
          </div>
        </>
      )}
    </div>

    <!-- Back: the same photo, tinted, with the excerpt -->
    <div class="flip-face flip-back bg-plum-900 text-pearl-50">
      <img src={img} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      <div class:list={['absolute inset-0', isCondition ? 'bg-orchid-700/82' : 'bg-plum-950/76']}></div>
      <div class="relative flex h-full flex-col justify-between p-7 sm:p-8">
        <div>
          <h3 class="font-display text-3xl leading-tight text-orchid-200">{title}</h3>
          <p class="mt-4 text-[0.95rem] leading-relaxed text-pearl-50/90">{text}</p>
        </div>
        <a href={href} class="link-u inline-flex items-center gap-2 self-start font-semibold">
          View more
          <svg viewBox="0 0 20 20" class="h-4 w-4 fill-none stroke-current" stroke-width="1.5" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
        </a>
      </div>
    </div>
  </div>
</li>
