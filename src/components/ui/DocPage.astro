---
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props { title: string; description?: string; kicker?: string }
const { title, description, kicker } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="bg-pearl-50 pb-24 pt-40 md:pt-48">
    <div class="wrap max-w-3xl">
      {kicker && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orchid-700">{kicker}</p>}
      <h1 class="mt-3 font-display text-5xl font-light text-plum-900 md:text-6xl">{title}</h1>
      <div class="mt-10 space-y-5 leading-relaxed text-ink [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-3xl [&_h2]:text-plum-900 [&_a:not(.btn)]:text-orchid-700 [&_a:not(.btn)]:underline">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
