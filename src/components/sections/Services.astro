---
import { services, specialties } from '../../data/content';
import { photo } from '../../data/images';
import FlipCard from '../ui/FlipCard.astro';

interface Props { all?: boolean; kind?: 'specialties' | 'gyn' }
const { all = false, kind = 'specialties' } = Astro.props;

const isSpec = kind === 'specialties';
const featured = ['pelvic-pain', 'contraception', 'hysteroscopy', 'menopause', 'irregular-bleeding', 'telemedicine'];
const gyn = all ? services : services.filter((s) => featured.includes(s.slug));
const items = isSpec
  ? specialties.map((s) => ({ ...s, href: s.href ?? `/${s.slug}` }))
  : gyn.map((s) => ({ ...s, href: `/services#${s.slug}` }));
---

<section id={isSpec ? 'services' : 'gyn-services'} class="section on-dark bg-plum-900 text-pearl-50">
  <div class="wrap">
    <div class="mb-14 grid gap-6 lg:grid-cols-12">
      <h2 class="h2 lg:col-span-7">{isSpec ? 'Our services' : 'Gynecology services'}</h2>
      <p class="lede lg:col-span-5 lg:self-end">
        {isSpec
          ? 'Primary care, gynecology, mental health, pain and weight care, and aesthetics, together in one practice. Hover over a card to learn more.'
          : 'From annual care to complex procedures, everything happens in one welcoming office. Hover over a card to learn more.'}
      </p>
    </div>

    <ul class:list={['grid gap-6 sm:grid-cols-2', isSpec ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
      {items.map((s) => (
        <FlipCard
          id={s.slug}
          title={s.name}
          text={s.text}
          img={photo(s.img, 800, 800)}
          href={s.href}
          class="aspect-[4/3] sm:aspect-square"
        />
      ))}
    </ul>

    {!all && !isSpec && (
      <div class="mt-14 text-center">
        <a href="/services" class="btn btn-light">View all services</a>
      </div>
    )}
  </div>
</section>
