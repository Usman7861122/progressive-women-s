---
import { site } from '../../data/site';
const explore = [
  { label: 'Gynecology', href: '/gynecology' },
  { label: 'Primary care', href: '/primary-care' },
  { label: 'Psychiatry and counseling', href: '/psychiatry' },
  { label: 'Pain management', href: '/pain-management' },
  { label: 'Weight management', href: '/weight-management' },
  { label: 'Aesthetics', href: '/aesthetics' },
  { label: 'Shop', href: '/shop' },
  { label: 'Our Team', href: '/team' },
];
---

<footer class="on-dark bg-plum-950 text-pearl-50/80">
  <div class="wrap grid gap-12 py-20 md:grid-cols-12">
    <div class="md:col-span-4">
      <img src="/images/logo.png" alt={site.name} width="455" height="197" class="h-20 w-auto brightness-0 invert" loading="lazy" />
      <p class="mt-6 max-w-sm font-display text-2xl font-light text-pearl-50">{site.tagline}</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">Primary care, gynecology, men’s health, psychiatry, counseling, pain management, weight management and aesthetics in Kenner, LA and Friendswood, TX.</p>
    </div>

    <nav class="md:col-span-3" aria-label="Footer">
      <h2 class="font-display text-2xl text-pearl-50">Explore</h2>
      <ul class="-ml-4 mt-3 flex flex-col items-start">
        {explore.map((n) => <li><a href={n.href} class="nav-pill">{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="md:col-span-5">
      <h2 class="font-display text-2xl text-pearl-50">Our offices</h2>
      <div class="mt-4 grid gap-8 sm:grid-cols-2">
        {site.locations.map((l) => (
          <address class="not-italic leading-relaxed">
            <p class="font-semibold text-pearl-50">{l.name}</p>
            {l.note && <p class="text-sm text-pearl-50/60">{l.note}</p>}
            {l.lines.map((line) => <p>{line}</p>)}
            <a class="link-u" href={`tel:${l.phone}`}>{l.phone}</a>
          </address>
        ))}
      </div>
      <p class="mt-6 text-sm"><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="mt-4 flex gap-6">
        {site.social.map((s) => <li><a class="link-u" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-pearl-50/10">
    <div class="wrap grid gap-6 py-8 text-sm text-pearl-50/60 md:grid-cols-12">
      <div class="space-y-2 md:col-span-8">
        <p>{site.disclaimer}</p>
        <p>Crisis support: call or text 988.</p>
        <p>© {new Date().getFullYear()} {site.legal}. All rights reserved.</p>
      </div>
      <ul class="flex flex-wrap content-start gap-x-6 gap-y-2 md:col-span-4 md:justify-end">
        <li><a class="link-u" href="/privacy-legal">Privacy &amp; Legal Notices</a></li>
        <li><a class="link-u" href="/hipaa-notice">HIPAA Notice</a></li>
        <li><a class="link-u" href="/pay-bill">Pay My Bill</a></li>
      </ul>
    </div>
  </div>
</footer>
