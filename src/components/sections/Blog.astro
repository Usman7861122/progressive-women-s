---
import { posts } from '../../data/content';
import { photo } from '../../data/images';
---

<section id="blog" class="section bg-pearl-50">
  <div class="wrap">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
      <h2 class="h2 text-plum-900">From our blog</h2>
      <a href="#" class="btn btn-solid">View all articles</a>
    </div>

    <ul class="grid gap-10 md:grid-cols-3">
      {posts.map((p) => (
        <li>
          <article class="group">
            <a href={p.href} class="block">
              <div class="aspect-square overflow-hidden rounded-lg bg-pearl-200">
                <img src={photo(p.img, 800, 800)} alt="" width="800" height="800" loading="lazy" class="h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105" />
              </div>
              <h3 class="mt-6 font-display text-[1.9rem] leading-tight text-plum-900">{p.title}</h3>
              <p class="mt-3 text-muted">{p.text}</p>
              <span class="link-u mt-4 inline-block font-semibold text-orchid-600">Read more</span>
            </a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
