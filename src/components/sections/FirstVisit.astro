---
import FirstVisitSteps from '../react/FirstVisitSteps';
import { steps } from '../../data/content';
import { photo } from '../../data/images';
import { site } from '../../data/site';

const items = steps.map((s) => ({ ...s, img: photo(s.img, 900, 900) }));
---

<section id="first-visit" class="section on-dark bg-plum-900 text-pearl-50">
  <div class="wrap">
    <h2 class="h2 mb-14 max-w-2xl">What to expect at your first visit</h2>
    <FirstVisitSteps client:visible steps={items} />

    <div class="mt-20 flex flex-col items-start justify-between gap-6 rounded-lg bg-plum-800 p-8 md:flex-row md:items-center md:p-12">
      <p class="font-display text-3xl font-light md:text-4xl">Prefer to stay home? See Dr. Mohsin by video.</p>
      <a href={site.bookingUrl} class="btn btn-light shrink-0">Book a virtual visit</a>
    </div>
  </div>
</section>
