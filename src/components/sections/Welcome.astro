---
import { site } from '../../data/site';
import ShaderBackground from '../react/ShaderBackground';
import WelcomeCollage from '../react/WelcomeCollage';

const promises = [
  { n: '01', title: 'Clinical excellence', text: 'PWH Specialities started over 10 years ago as an OB/GYN practice providing complex laparoscopic and hysteroscopic procedures. Today it has grown to include multiple specialities, including mental health, primary care and aesthetics.' },
  { n: '02', title: 'Compassionate care', text: 'Prevention first, and time to explain every step, so you always know what comes next.' },
  { n: '03', title: 'A service that feels personal', text: 'You are heard, not hurried. Your plan is made for you, not for a chart.' },
];
---

<section id="about" class="section relative isolate overflow-hidden bg-pearl-50">
  <ShaderBackground client:visible className="absolute inset-0 -z-20" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-pearl-50 via-pearl-50/30 to-pearl-50/80" aria-hidden="true"></div>

  <div class="wrap grid items-center gap-16 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <WelcomeCollage
        client:load
        main="/images/about/asia-mohsin.jpg"
        second="/images/about/small.jpg"
        rating={site.rating.score}
        reviews={site.rating.count}
        reviewsUrl={site.googleReviewsUrl}
      />
    </div>

    <div class="lg:col-span-7">
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-orchid-700">
        <span class="h-px w-10 bg-champagne" aria-hidden="true"></span> Our story
      </p>
      <h2 class="h2 mt-5 text-plum-900">Welcome to Progressive Women’s Health</h2>
      <p class="mt-6 max-w-2xl font-display text-2xl italic leading-snug text-plum-800 md:text-3xl">
        Care for body and mind, together in one practice.
      </p>

      <ol class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-3">
        {promises.map((p) => (
          <li class="border-t border-champagne/70 pt-4">
            <span class="font-display text-3xl text-orchid-600">{p.n}</span>
            <h3 class="mt-2 text-base font-semibold text-plum-900" style="font-family: var(--font-sans)">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.text}</p>
          </li>
        ))}
      </ol>

      <p class="mt-10 max-w-xl text-muted">
        Dr. Asia Mohsin has a special interest in heavy bleeding. She also teaches, serving as a preceptor for nurse
        practitioners during OB/GYN and women’s health rotations.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href="/#contact" class="shiny"><span>Book Telemedicine</span></a>
        <p class="ml-auto font-display text-3xl italic text-orchid-700 max-sm:ml-0" aria-label="Dr. Asia Mohsin">Dr. Asia Mohsin</p>
      </div>
    </div>
  </div>
</section>
