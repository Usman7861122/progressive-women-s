---
import { conditions } from '../../data/content';
import { photo } from '../../data/images';
import FlipCard from '../ui/FlipCard.astro';

interface Props { all?: boolean; heading?: string }
const { all = false, heading = 'Gynecologic conditions' } = Astro.props;

const featured = ['menopause', 'heavy-periods-menorrhagia', 'polycystic-ovarian-syndrome-pcos', 'ovarian-cysts', 'uterine-fibroids', 'infertility', 'annual-exams', 'sexually-transmitted-infections'];
const items = all ? conditions : conditions.filter((c) => featured.includes(c.slug));
---

<section id="conditions" class="section scroll-mt-20 bg-pearl-100">
  <div class="wrap">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class="h2 text-plum-900">{heading}</h2>
        <p class="lede mt-6">Every gynecologic condition we care for, each with its own page. You will get a clear explanation and a plan made for you. Hover over a card to read more.</p>
      </div>
          </div>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((c) => (
        <FlipCard
          variant="condition"
          id={c.slug}
          title={c.short ?? c.name}
          text={c.text}
          img={photo(c.img, 800, 1000)}
          href={`/conditions/${c.slug}`}
          class="aspect-[5/4] sm:aspect-[4/5]"
        />
      ))}
    </ul>
  </div>
</section>
