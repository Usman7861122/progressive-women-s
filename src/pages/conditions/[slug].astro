---
import ConditionLayout from '../../components/sections/ConditionLayout.astro';
import { allConditionPages } from '../../data/condition-pages';

export function getStaticPaths() {
  return allConditionPages.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---

<ConditionLayout c={c} />
