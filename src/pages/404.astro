---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="wrap flex min-h-[70svh] flex-col items-start justify-center pt-24">
    <h1 class="h2 text-plum-900">We could not find that page</h1>
    <p class="lede mt-4">The link may be old or mistyped.</p>
    <a href="/" class="btn btn-solid mt-8">Back to home</a>
  </section>
</BaseLayout>
