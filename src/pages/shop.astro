---
import DocPage from '../components/ui/DocPage.astro';
import { site } from '../data/site';
---

<DocPage title="Shop" kicker="Coming soon" description="Shop online for healthcare products from Progressive Women's Health. Shop coming soon.">
  <p><strong>Shop online for healthcare products. Shop coming soon.</strong></p>
  <p>Our online shop is on its way. It will offer healthcare, wellness and skin-care products selected by our clinicians. Products, prices and photos will be added here soon.</p>
  <p>Prescription products are not sold online. Checkout will open a secure, hosted payment page, and we will email you a receipt.</p>
  <p class="text-sm text-muted">These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure or prevent any disease.</p>
  <p><a href={`mailto:${site.email}`} class="btn btn-solid">Ask about a product</a></p>
</DocPage>
