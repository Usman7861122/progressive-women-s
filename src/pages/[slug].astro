---
import BaseLayout from '../layouts/BaseLayout.astro';
import { specialtyPages, slugify } from '../data/specialty-pages';
import { photo } from '../data/images';
import { site } from '../data/site';
import CategoryCard from '../components/ui/CategoryCard.astro';

export function getStaticPaths() {
  return specialtyPages.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const cardLayout = !!s.groups?.length && s.groups.every((g) => g.excerpt);
const cardsWithImg = !!s.cards && s.cards.items.every((c) => c.img);
const flat = (i: any) => (typeof i === 'string' ? i : i.text);
const others = specialtyPages.filter((o) => o.slug !== s.slug);
---

<BaseLayout title={s.name} description={s.intro}>
  <section class="relative isolate overflow-hidden bg-plum-950 pb-20 pt-40 text-pearl-50 md:pb-28 md:pt-48">
    <img src={photo(s.img, 2000)} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-plum-950 via-plum-950/70 to-plum-950/40" aria-hidden="true"></div>
    <div class="wrap max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-champagne">{s.badge ?? s.name}</p>
      <h1 class="mt-4 font-display text-4xl font-light leading-[1.08] md:text-6xl">{s.headline}</h1>
      <p class="mt-6 max-w-2xl font-display text-xl italic text-orchid-200 md:text-2xl">{s.intro}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={site.bookingUrl} class="shiny"><span>Book a telemedicine visit</span></a>
        <a href={`tel:${site.phoneBook}`} class="btn btn-line">Call {site.phoneBook}</a>
      </div>
    </div>
  </section>

  {(s.barLeft || s.barRight) && (
    <div class="border-b border-pearl-200 bg-pearl-100">
      <div class="wrap flex flex-wrap items-center justify-between gap-2 py-3 text-sm text-plum-900">
        <span>{s.barLeft}</span><span class="text-muted">{s.barRight}</span>
      </div>
    </div>
  )}

  <section class="section bg-pearl-50">
    <div class="wrap space-y-16">
      {cardsWithImg && (
        <div id={slugify(s.cards!.title)} class="scroll-mt-28">
          <h2 class="h2 text-plum-900">{s.cards!.title}</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {s.cards!.items.map((c) => (
              <CategoryCard
                id={slugify(c.title)}
                title={c.title}
                excerpt={c.text}
                detail={c.text}
                img={photo(c.img!, 900, 1100)}
                items={[{ label: s.cta, href: `/?topic=${encodeURIComponent(c.title)}#contact` }]}
              />
            ))}
          </ul>
        </div>
      )}

      {s.cards && !cardsWithImg && (
        <div>
          <h2 class="h2 text-plum-900" id={slugify(s.cards.title)}>{s.cards.title}</h2>
          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {s.cards.items.map((c) => (
              <li class="rounded-xl border border-pearl-200 bg-pearl-100 p-6">
                <h3 class="font-display text-xl text-plum-900">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink">{c.text}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cardLayout && (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {s.groups!.map((g) => (
            <CategoryCard
              id={slugify(g.title)}
              title={g.title}
              excerpt={g.excerpt!}
              img={photo(g.img!, 900, 1100)}
              items={g.items.map((i) => ({ label: flat(i), href: `/?topic=${encodeURIComponent(flat(i))}#contact` }))}
            />
          ))}
        </ul>
      )}

      {s.groups && !cardLayout && (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {s.groups.map((g) => (
            <section id={slugify(g.title)} class="scroll-mt-28 rounded-xl border border-pearl-200 bg-pearl-100 p-6">
              <h3 class="font-display text-xl text-plum-900">{g.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {g.items.map((i) => (
                  <li class="flex gap-3 text-sm leading-snug text-ink">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-orchid-600" aria-hidden="true"></span>
                    <span>
                      {typeof i === 'string' ? i : i.text}
                      {typeof i !== 'string' && (
                        <ul class="mt-1.5 space-y-1 text-muted">
                          {i.sub.map((x) => <li>– {x}</li>)}
                        </ul>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}

      {s.chips && (
        <div id={slugify(s.chips.title)} class="scroll-mt-28">
          <h2 class="h2 text-plum-900">{s.chips.title}</h2>
          <ul class="mt-6 flex flex-wrap gap-3">
            {s.chips.items.map((c) => (
              <li class="rounded-full border border-orchid-200 bg-pearl-100 px-4 py-2 text-sm text-plum-900">{c}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-orchid-200 bg-pearl-100 p-6 text-sm leading-relaxed text-ink" role="note">
          <p class="font-semibold text-plum-900">Please note</p>
          <p class="mt-2">{s.notice}</p>
        </div>
        <div class="rounded-lg bg-plum-900 p-6 text-sm leading-relaxed text-pearl-50/85">
          <p>{site.disclaimer} Crisis support: call or text 988.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-pearl-100 py-20">
    <div class="wrap">
      <h2 class="font-display text-3xl text-plum-900">More of our care</h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {others.map((o) => (
          <li><a href={`/${o.slug}`} class="inline-flex rounded-full border border-pearl-200 bg-pearl-50 px-5 py-2 text-sm font-medium text-plum-900 transition-colors hover:border-orchid-600 hover:bg-orchid-600 hover:text-pearl-50">{o.nav}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
