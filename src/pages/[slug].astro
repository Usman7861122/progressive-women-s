---
import BaseLayout from '../layouts/BaseLayout.astro';
import { specialties } from '../data/content';
import { photo } from '../data/images';
import { site } from '../data/site';

export function getStaticPaths() {
  return specialties.filter((s) => !s.href).map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = specialties.filter((o) => o.slug !== s.slug);
---

<BaseLayout title={s.name} description={s.text}>
  <section class="relative isolate overflow-hidden bg-plum-950 pb-20 pt-40 text-pearl-50 md:pb-28 md:pt-48">
    <img src={photo(s.img, 2000)} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-plum-950 via-plum-950/70 to-plum-950/40" aria-hidden="true"></div>
    <div class="wrap max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-champagne">{s.group}</p>
      <h1 class="mt-4 font-display text-5xl font-light leading-[1.05] md:text-7xl">{s.name}</h1>
      <p class="mt-6 max-w-2xl font-display text-2xl italic text-orchid-200 md:text-3xl">{s.intro}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={site.bookingUrl} class="btn btn-light">Request an appointment</a>
        <a href={`tel:${site.phoneBook}`} class="btn btn-line">Call {site.phoneBook}</a>
      </div>
    </div>
  </section>

  <section class="section bg-pearl-50">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="h2 text-plum-900">How we can help</h2>
        <p class="lede mt-6">{s.text}</p>
        <ul class="mt-10 space-y-4">
          {s.points.map((p) => (
            <li class="flex gap-4 border-t border-champagne/60 pt-4 text-ink">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-orchid-600" aria-hidden="true"></span>{p}
            </li>
          ))}
        </ul>
      </div>
      <aside class="space-y-6 lg:col-span-5">
        {s.notice && (
          <div class="rounded-lg border border-orchid-200 bg-pearl-100 p-6 text-sm leading-relaxed text-ink" role="note">
            <p class="font-semibold text-plum-900">Please note</p>
            <p class="mt-2">{s.notice}</p>
          </div>
        )}
        <div class="rounded-lg bg-plum-900 p-6 text-sm leading-relaxed text-pearl-50/85">
          <p>{site.disclaimer} Crisis support: call or text 988.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-pearl-100 py-20">
    <div class="wrap">
      <h2 class="font-display text-3xl text-plum-900">More of our care</h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {others.map((o) => (
          <li><a href={o.href ?? `/${o.slug}`} class="inline-flex rounded-full border border-pearl-200 bg-pearl-50 px-5 py-2 text-sm font-medium text-plum-900 transition-colors hover:border-orchid-600 hover:bg-orchid-600 hover:text-pearl-50">{o.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
